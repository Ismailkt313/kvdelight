# Production / Canonical Site URL
# Set this in your Vercel project environment variables (or hosting provider)
# to ensure canonical URLs, Open Graph tags, sitemaps, and robots.txt resolve correctly.
NEXT_PUBLIC_SITE_URL=https://kvdelight.vercel.app

# Optional: Google Search Console verification code (if using meta tag verification)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_code_here

# Optional: Bing Webmaster Tools verification code
# NEXT_PUBLIC_BING_SITE_VERIFICATION=your_verification_code_here
